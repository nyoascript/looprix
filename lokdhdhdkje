    -- Load saved offsets
    if CONFIG._autoPlayOffsets then
        for _, side in ipairs({"L","R"}) do
            for _, key in ipairs(AP.POINT_KEYS) do
                if CONFIG._autoPlayOffsets[side] and CONFIG._autoPlayOffsets[side][key] then
