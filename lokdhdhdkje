local desyncEnabled = false
local desyncLoopConn = nil
local desyncPanelGui = nil
local desyncPanelBtn = nil

local DesyncSettings = {
    ["Rendering.S2PhysicsSenderRate"] = 1,
    ["Rendering.SimRadius"]           = 0,
}

local function executeDesyncPayload()
    pcall(function()
        local ReplicatedStorage = S.ReplicatedStorage
        local Packages = ReplicatedStorage:WaitForChild("Packages", 5)
        local Net = Packages and Packages:FindFirstChild("Net")
        if Net then
            local UseItemRemote    = Net:FindFirstChild("RE/UseItem")
            local TeleportRemote   = Net:FindFirstChild("RE/QuantumCloner/OnTeleport")
            for flagName, flagValue in pairs(DesyncSettings) do
                pcall(function()
                    setfflag(tostring(flagName), tostring(flagValue))
                end)
            end
            if UseItemRemote  then pcall(function() UseItemRemote:FireServer()  end) end
            if TeleportRemote then pcall(function() TeleportRemote:FireServer() end) end
        end
    end)
end

local function specialRespawn(plr)
    local char = plr.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.Health = 0
            hum:ChangeState(Enum.HumanoidStateType.Dead)
        end
        char:ClearAllChildren()
        local newChar = Instance.new("Model")
        newChar.Parent = workspace
        plr.Character = newChar
        task.wait()
        plr.Character = char
        newChar:Destroy()
    end
end

local function startDesync()
    executeDesyncPayload()
    local wasAntiDieOn = CONFIG.ANTI_DIE_ENABLED
    if wasAntiDieOn then deactivateAntiDie() end

    pcall(function() raknet.desync(true) end)

    if S.LocalPlayer.Character then
        local hum = S.LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.Health = 0 end
        S.LocalPlayer.Character:Destroy()
    end

    task.wait(0.1)
    task.spawn(function()
        specialRespawn(S.LocalPlayer)
        if wasAntiDieOn then
            task.wait(0.4)
            activateAntiDie()
        end
    end)

    desyncEnabled = true
end

local function stopDesync()
    pcall(function() raknet.desync(false) end)
    desyncEnabled = false
end

local function toggleDesync(state)
    CONFIG.DESYNC_ENABLED = state
    if state then
        startDesync()
    else
        stopDesync()
    end
    saveConfig()
end

-- ======================================
-- FLOAT SYSTEM  (velocity-based rise, speed slider)
-- ======================================

local floatModeConn     = nil
local floatEnabled      = false
local _floatCurHip      = 0
local _floatTpInProgress = false
local _floatGeneration  = 0

local function tpDown()
    pcall(function()
        local char = character
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local params = RaycastParams.new()
        params.FilterDescendantsInstances = {char}
        params.FilterType = Enum.RaycastFilterType.Exclude
        local result = workspace:Raycast(hrp.Position, Vector3.new(0, -500, 0), params)
        if result then
            -- snap to ground, preserve rotation (no CFrame.Rotation override)
            local rot = hrp.CFrame - hrp.CFrame.Position
            hrp.CFrame = CFrame.new(result.Position + Vector3.new(0, 3, 0)) * rot
            hrp.AssemblyLinearVelocity  = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        else
            -- fallback: slam velocity
            hrp.AssemblyLinearVelocity = Vector3.new(
                hrp.AssemblyLinearVelocity.X, -100,
                hrp.AssemblyLinearVelocity.Z)
        end
    end)
end

-- Синхронизировать текст кнопки Float с текущим состоянием
local function _syncFloatBtn(active)
    if not floatPanelBtn then return end
    floatPanelBtn.Text       = active and "FLOAT: ON" or "FLOAT: OFF"
    floatPanelBtn.TextColor3 = COLORS.Accent  -- всегда акцентный
    pcall(function() trackLabel(floatPanelBtn) end)
end

local function startFloat()
    if not CONFIG.FLOAT_PANEL_VISIBLE then return end
    if floatModeConn then return end
    floatEnabled        = true
    CONFIG.FLOAT_ACTIVE = true
    _floatCurHip        = 0
    _floatTpInProgress  = false
    pcall(function()
        local hum = character and character:FindFirstChildOfClass("Humanoid")
        if hum then _floatCurHip = hum.HipHeight end
    end)
    _syncFloatBtn(true)

    local myGen = _floatGeneration  -- снимок поколения при старте

    floatModeConn = S.RunService.Heartbeat:Connect(function()
        if not floatEnabled then return end
        if _floatTpInProgress then return end
        pcall(function()
            local char = character
            local hum  = char and char:FindFirstChildOfClass("Humanoid")
            local hrp  = char and char:FindFirstChild("HumanoidRootPart")
            if not hum or not hrp then return end

            local target = CONFIG.FLOAT_HEIGHT or 10
            local speed  = math.clamp(CONFIG.FLOAT_SPEED or 50, 1, 100)
            local step   = (speed / 100) * 2.0

            if _floatCurHip < target then
                _floatCurHip = math.min(_floatCurHip + step, target)
            elseif _floatCurHip > target then
                _floatCurHip = math.max(_floatCurHip - step * 5, target)
            end

            if math.abs(hum.HipHeight - _floatCurHip) > 0.01 then
                hum.HipHeight = _floatCurHip
            end

            -- Auto TP Down: пауза через флаг + генерация для отмены
            if CONFIG.AUTO_TP_DOWN_ENABLED
               and _floatCurHip >= target - 0.05 then
                _floatTpInProgress = true
                hum.HipHeight = 2
                _floatCurHip  = 0
                task.delay(0.05, function()
                    -- если float выключили пока ждали — отмена
                    if not floatEnabled or _floatGeneration ~= myGen then
                        _floatTpInProgress = false
                        return
                    end
                    tpDown()
                    task.delay(0.08, function()
                        -- ещё раз проверяем — вдруг выключили между delay
                        if _floatGeneration ~= myGen then
                            _floatTpInProgress = false
                            return
                        end
                        _floatTpInProgress = false
                    end)
                end)
            end
        end)
    end)
    addConnection(floatModeConn)
end

local function stopFloat()
    floatEnabled        = false
    CONFIG.FLOAT_ACTIVE = false
    _floatTpInProgress  = false
    _floatGeneration    = _floatGeneration + 1  -- инвалидирует все pending task.delay
    if floatModeConn then
        floatModeConn:Disconnect()
        floatModeConn = nil
    end
    pcall(function()
        local char = character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum.HipHeight = 2 end
    end)
    _floatCurHip = 0
    _syncFloatBtn(false)
    task.delay(0.05, function()
        tpDown()
    end)
    saveConfig()
end

