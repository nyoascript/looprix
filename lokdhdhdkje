            minBtn.Text="-"
        end
    end)

    -- Drag
    local dsDrag,dsDS,dsDSP=false,nil,nil
    main.InputBegan:Connect(function(inp)
        if CONFIG.UI_LOCKED then return end
        if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
            dsDrag=false; dsDS=inp.Position; dsDSP=main.Position
        end
    end)
    S.UserInputService.InputChanged:Connect(function(inp)
        if CONFIG.UI_LOCKED or not dsDS then return end
        if inp.UserInputType==Enum.UserInputType.MouseMovement or inp.UserInputType==Enum.UserInputType.Touch then
            if (inp.Position-dsDS).Magnitude>5 then
                dsDrag=true
                local d=inp.Position-dsDS
                main.Position=UDim2.new(dsDSP.X.Scale,dsDSP.X.Offset+d.X,dsDSP.Y.Scale,dsDSP.Y.Offset+d.Y)
            end
        end
    end)
    main.InputEnded:Connect(function(inp)
        if inp.UserInputType==Enum.UserInputType.MouseButton1 or inp.UserInputType==Enum.UserInputType.Touch then
            if dsDrag then
                CONFIG._guiPositions = CONFIG._guiPositions or {}
                CONFIG._guiPositions.desyncPanel = {
                    scaleX=main.Position.X.Scale, scaleY=main.Position.Y.Scale,
                    offsetX=main.Position.X.Offset, offsetY=main.Position.Y.Offset,
                }
                saveConfig()
            end
            dsDrag=false; dsDS=nil
        end
    end)

    desyncPanelGui = sg
    pcall(function()
        applyAccentColor(CONFIG.GUI_COLOR_R or 0, CONFIG.GUI_COLOR_G or 217, CONFIG.GUI_COLOR_B or 127)
    end)
    return sg
end

