    end)

    floatPanelGui, floatPanelBtn = createFloatingPanel("Float", "floatPanel", "FLOAT_PANEL_VISIBLE", "FLOAT: " .. (CONFIG.FLOAT_ACTIVE and "ON" or "OFF"))

