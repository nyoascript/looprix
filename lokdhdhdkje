-- ======================================
-- DRAG / CLAMP UTILITY  (shared by every draggable element)
-- ======================================

local _UIS = game:GetService("UserInputService")
local _RS  = game:GetService("RunService")

-- Returns the absolute pixel size of the current viewport.
local function _getViewport()
    local cam = workspace.CurrentCamera
    return cam and cam.ViewportSize or Vector2.new(1920, 1080)
end

-- Clamps frame so it stays fully inside the viewport.
-- padX/padY add an inner margin (default 4 px each side).
local function clampToScreen(frame, padX, padY)
    padX = padX or 4
    padY = padY or 4
    local vp   = _getViewport()
    local size = frame.AbsoluteSize       -- real pixel dimensions (respects UIScale)
    local pos  = frame.AbsolutePosition   -- real pixel top-left

    local minX = padX
    local minY = padY
    local maxX = vp.X - size.X - padX
    local maxY = vp.Y - size.Y - padY

    local cx = math.clamp(pos.X, minX, maxX)
    local cy = math.clamp(pos.Y, minY, maxY)

    -- Keep scale component, replace offset component
    frame.Position = UDim2.new(
        frame.Position.X.Scale, cx - frame.Position.X.Scale * vp.X,
        frame.Position.Y.Scale, cy - frame.Position.Y.Scale * vp.Y
    )
end

-- Generic drag-and-clamp.  Call once per draggable element.
-- `frame`     : the GuiObject to move
-- `handle`    : the part the user grabs (often == frame)
-- `saveKey`   : string key inside CONFIG._guiPositions to persist position
-- `lockedFn`  : optional function() → bool; if true dragging is blocked
-- `onSaved`   : optional callback after save
local function makeDraggable(frame, handle, saveKey, lockedFn, onSaved)
    handle = handle or frame
    lockedFn = lockedFn or function() return false end

    local active    = false
    local dragging  = false
    local dragStart = nil
    local startPos  = nil
    local dragInput = nil  -- track the exact InputObject that started the drag

    handle.InputBegan:Connect(function(inp)
        if lockedFn() then return end
        if inp.UserInputType ~= Enum.UserInputType.MouseButton1 and
           inp.UserInputType ~= Enum.UserInputType.Touch then return end
        active    = true
        dragging  = false
        dragInput = inp
        dragStart = Vector2.new(inp.Position.X, inp.Position.Y)
        startPos  = frame.Position
        -- Sink input so the game camera/player doesn't react
        inp.Handled = true
    end)

    _UIS.InputChanged:Connect(function(inp)
        if not active or lockedFn() then return end
        if inp ~= dragInput then return end
        if not dragStart then return end
        local delta = Vector2.new(inp.Position.X, inp.Position.Y) - dragStart
        if not dragging and delta.Magnitude < 5 then return end
        dragging = true
        local newPos = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
        frame.Position = newPos
        clampToScreen(frame)
    end)

    _UIS.InputEnded:Connect(function(inp)
        if not active then return end
        if inp ~= dragInput then return end
        active = false
        if dragging then
            clampToScreen(frame)
            if saveKey then
                CONFIG._guiPositions = CONFIG._guiPositions or {}
                CONFIG._guiPositions[saveKey] = {
                    scaleX  = frame.Position.X.Scale,
                    scaleY  = frame.Position.Y.Scale,
                    offsetX = frame.Position.X.Offset,
                    offsetY = frame.Position.Y.Offset,
                }
                saveConfig()
                if onSaved then onSaved() end
            end
        end
        dragging  = false
        dragStart = nil
        dragInput = nil
    end)

    -- Return whether the last gesture was a tap (no drag) so callers can
    -- treat it as a click.
    return function() return not dragging end
end

-- Safe position loader: reads CONFIG._guiPositions[key], applies it to frame,
-- then immediately clamps to screen.  Falls back to `defaultPos` if no saved data.
local function loadAndClampPosition(frame, key, defaultPos)
    local pos = CONFIG._guiPositions and CONFIG._guiPositions[key]
    if pos then
        frame.Position = UDim2.new(pos.scaleX or 0, pos.offsetX or 0,
                                    pos.scaleY or 0, pos.offsetY or 0)
    elseif defaultPos then
        frame.Position = defaultPos
    end
    -- Wait one frame so AbsoluteSize is computed, then clamp
    task.defer(function()
        if frame and frame.Parent then clampToScreen(frame) end
    end)
end


