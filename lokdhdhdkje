        S.TweenService:Create(desyncPanelBtn, tweenInfoFast, {
            BackgroundColor3       = newState and COLORS.Accent or COLORS.Surface,
            BackgroundTransparency = newState and 0.0 or COLORS.SurfaceTransparency,
        }):Play()
        desyncPanelBtn.TextColor3 = newState and Color3.fromRGB(10,10,10) or COLORS.TextDim
        desyncPanelBtn.Text = newState and "DESYNC ON" or "DESYNC"
        showNotification("Desync", newState)
    end)

