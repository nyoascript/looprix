                    AP.offsets[side][key].z=CONFIG._autoPlayOffsets[side][key].z or 0
                end
            end
        end
    end

    apGuiInstance=sg
    pcall(function()
        applyAccentColor(CONFIG.GUI_COLOR_R or 0, CONFIG.GUI_COLOR_G or 217, CONFIG.GUI_COLOR_B or 127)
    end)
    return sg
