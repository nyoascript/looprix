local _autoBatGen = 0
local function autoAttack()
    _autoBatGen = _autoBatGen + 1
    local gen = _autoBatGen
    task.spawn(function()
        while CONFIG.AUTO_BAT_ENABLED and _autoBatGen == gen do
            local char = character
            if char then
                local bat = char:FindFirstChild("Bat")
                if bat then
                    pcall(function()
                        bat:Activate()
                    end)
                end
            end
            task.wait(0.15)
        end
    end)
end

