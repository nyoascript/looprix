        task.delay(0.4, function()
            S.TweenService:Create(respawnBtn, tweenInfoFast, {
                BackgroundColor3 = COLORS.Surface, BackgroundTransparency = COLORS.SurfaceTransparency,
            }):Play()
            respawnBtn.TextColor3 = COLORS.TextDim
        end)
