function Tab:Toggle(text, default, callback)
    local state = default and true or false
    local r = row(self, 34)

    label({
        Text = text,
        Size = UDim2.new(1, -70, 1, 0),
        Position = UDim2.fromOffset(12, 0),
        Parent = r,
    })

    local b = new("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        Parent = r,
    })

    local track = new("Frame", {
        Size = UDim2.fromOffset(34, 16),
        Position = UDim2.new(1, -46, 0.5, -8),
        BackgroundColor3 = Theme.Track,
        BorderSizePixel = 0,
        Parent = r,
    }, { corner(3) })

    local knob = new("Frame", {
        Size = UDim2.fromOffset(12, 12),
        Position = UDim2.fromOffset(2, 2),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        Parent = track,
    }, { corner(2) })

    local function render(animate)
        local pos = state and UDim2.fromOffset(20, 2) or UDim2.fromOffset(2, 2)
        local color = state and Theme.Accent or Theme.Track
        if animate then
            tween(knob, 0.14, { Position = pos })
            tween(track, 0.14, { BackgroundColor3 = color })
        else
            knob.Position = pos
            track.BackgroundColor3 = color
        end
    end

    render(false)
    hover(r, b)

    b.MouseButton1Click:Connect(function()
        state = not state
        render(true)
        fire(callback, state)
    end)

    local obj = { Value = state }
    function obj:Set(v)
        state = v and true or false
        obj.Value = state
        render(true)
        fire(callback, state)
    end
    function obj:Get()
        return state
    end
    return obj
end

function Tab:Slider(text, min, max, default, callback, suffix, decimals)
    suffix = suffix or ""
    decimals = decimals or 0
    local mult = 10 ^ decimals
    local value = math.clamp(default or min, min, max)
    local r = row(self, 46)

    label({
        Text = text,
        Size = UDim2.new(0.6, -12, 0, 24),
        Position = UDim2.fromOffset(12, 2),
        Parent = r,
    })

    local valueLabel = label({
        Text = "",
        Font = Fonts.Medium,
        TextColor3 = Theme.Accent2,
        TextXAlignment = Enum.TextXAlignment.Right,
        Size = UDim2.new(0.4, -12, 0, 24),
        Position = UDim2.new(0.6, 0, 0, 2),
        Parent = r,
    })

    local bar = new("Frame", {
        Size = UDim2.new(1, -24, 0, 4),
        Position = UDim2.new(0, 12, 0, 32),
        BackgroundColor3 = Theme.Track,
        BorderSizePixel = 0,
        Parent = r,
    }, { corner(2) })

    local fill = new("Frame", {
        Size = UDim2.fromScale(0, 1),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        Parent = bar,
    }, { corner(2), gradient(0) })

    new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.fromOffset(8, 12),
        Position = UDim2.fromScale(1, 0.5),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        Parent = fill,
    }, { corner(2) })

    local hit = new("TextButton", {
        Size = UDim2.new(1, -24, 0, 22),
        Position = UDim2.fromOffset(12, 23),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        Parent = r,
    })

    local function setValue(v, silent)
        v = math.clamp(v, min, max)
        v = math.floor(v * mult + 0.5) / mult
        local changed = v ~= value
        value = v
        local a = (max - min) == 0 and 0 or (v - min) / (max - min)
        fill.Size = UDim2.new(a, 0, 1, 0)
        valueLabel.Text = tostring(v) .. suffix
        if changed and not silent then
            fire(callback, v)
        end
    end

    setValue(value, true)

    local dragging = false

    local function updateFromX(x)
        local a = math.clamp((x - bar.AbsolutePosition.X) / math.max(bar.AbsoluteSize.X, 1), 0, 1)
        setValue(min + (max - min) * a)
    end

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromX(input.Position.X)
        end
    end)

    connect(UserInputService.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromX(input.Position.X)
        end
    end)

    connect(UserInputService.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    local obj = {}
    function obj:Set(v)
        setValue(v)
    end
    function obj:Get()
        return value
    end
    return obj
end

function Tab:Input(text, default, placeholder, callback)
    local r = row(self, 34)

    label({
        Text = text,
        Size = UDim2.new(0.4, -12, 1, 0),
        Position = UDim2.fromOffset(12, 0),
        Parent = r,
    })

    local box = new("Frame", {
        Size = UDim2.new(0.6, -20, 0, 24),
        Position = UDim2.new(0.4, 0, 0.5, -12),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        Parent = r,
    }, { corner(3), stroke(Theme.Stroke) })

    local tb = new("TextBox", {
        Size = UDim2.new(1, -12, 1, 0),
        Position = UDim2.fromOffset(6, 0),
        BackgroundTransparency = 1,
        Text = default or "",
        PlaceholderText = placeholder or "Type...",
        PlaceholderColor3 = Theme.SubText,
        Font = Fonts.Regular,
        TextSize = 12,
        TextColor3 = Theme.Text,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
        Parent = box,
    })

    tb.Focused:Connect(function()
        tween(box:FindFirstChildOfClass("UIStroke"), 0.15, { Color = Theme.Accent })
    end)
    tb.FocusLost:Connect(function()
        tween(box:FindFirstChildOfClass("UIStroke"), 0.15, { Color = Theme.Stroke })
        fire(callback, tb.Text)
    end)

    local obj = {}
    function obj:Set(v)
        tb.Text = tostring(v)
        fire(callback, tb.Text)
    end
    function obj:Get()
        return tb.Text
    end
    return obj
end

function Tab:Dropdown(text, options, default, callback)
    local selected = default or options[1]
    local open = false
    local itemHeight = 26
    local headerHeight = 34
    local r = row(self, headerHeight)
    r.ClipsDescendants = true

    label({
        Text = text,
        Size = UDim2.new(0.5, -12, 0, headerHeight),
        Position = UDim2.fromOffset(12, 0),
        Parent = r,
    })

    local valueLabel = label({
        Text = tostring(selected),
        TextColor3 = Theme.Accent2,
        TextXAlignment = Enum.TextXAlignment.Right,
        Size = UDim2.new(0.5, -36, 0, headerHeight),
        Position = UDim2.new(0.5, 0, 0, 0),
        Parent = r,
    })

    local arrow = label({
        Text = ">",
        Font = Fonts.Bold,
        TextColor3 = Theme.SubText,
        TextXAlignment = Enum.TextXAlignment.Center,
        Size = UDim2.fromOffset(16, headerHeight),
        Position = UDim2.new(1, -26, 0, 0),
        Parent = r,
    })
    arrow.AnchorPoint = Vector2.new(0, 0)

    local header = new("TextButton", {
        Size = UDim2.new(1, 0, 0, headerHeight),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        Parent = r,
    })

    local list = new("Frame", {
        Size = UDim2.new(1, 0, 0, #options * itemHeight),
        Position = UDim2.fromOffset(0, headerHeight),
        BackgroundTransparency = 1,
        Parent = r,
    }, {
        new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }),
    })

    local buttons = {}

    local function refresh()
        for opt, b in pairs(buttons) do
            b.TextColor3 = opt == selected and Theme.Accent2 or Theme.SubText
        end
        valueLabel.Text = tostring(selected)
    end

    for i, opt in ipairs(options) do
        local b = new("TextButton", {
            Size = UDim2.new(1, 0, 0, itemHeight),
            BackgroundColor3 = Theme.PanelLight,
            BackgroundTransparency = 1,
            Text = tostring(opt),
            Font = Fonts.Medium,
            TextSize = 12,
            TextColor3 = Theme.SubText,
            TextXAlignment = Enum.TextXAlignment.Left,
            AutoButtonColor = false,
            LayoutOrder = i,
            Parent = list,
        }, {
            new("UIPadding", { PaddingLeft = UDim.new(0, 12) }),
        })
        buttons[opt] = b
        b.MouseEnter:Connect(function()
            tween(b, 0.1, { BackgroundTransparency = 0 })
        end)
        b.MouseLeave:Connect(function()
            tween(b, 0.1, { BackgroundTransparency = 1 })
        end)
        b.MouseButton1Click:Connect(function()
            selected = opt
            refresh()
            fire(callback, opt)
        end)
    end

    refresh()

    header.MouseEnter:Connect(function()
        tween(r, 0.12, { BackgroundColor3 = Theme.PanelLight })
    end)
    header.MouseLeave:Connect(function()
        tween(r, 0.12, { BackgroundColor3 = Theme.Panel })
    end)

    header.MouseButton1Click:Connect(function()
        open = not open
        tween(r, 0.16, { Size = UDim2.new(1, 0, 0, open and (headerHeight + #options * itemHeight + 4) or headerHeight) })
        tween(arrow, 0.16, { Rotation = open and 90 or 0 })
    end)

    local obj = {}
    function obj:Set(opt)
        if buttons[opt] then
            selected = opt
            refresh()
            fire(callback, opt)
        end
    end
    function obj:Get()
        return selected
    end
    return obj
end

function Tab:Keybind(text, default, callback)
    local key = default
    local listening = false
    local r = row(self, 34)

    label({
        Text = text,
        Size = UDim2.new(1, -120, 1, 0),
        Position = UDim2.fromOffset(12, 0),
        Parent = r,
    })

    local b = new("TextButton", {
        Size = UDim2.fromOffset(88, 22),
        Position = UDim2.new(1, -100, 0.5, -11),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        Text = key.Name,
        Font = Fonts.Medium,
        TextSize = 12,
        TextColor3 = Theme.Accent2,
        AutoButtonColor = false,
        Parent = r,
    }, { corner(3), stroke(Theme.Stroke) })

    b.MouseButton1Click:Connect(function()
        listening = true
        Capturing = true
        b.Text = "..."
    end)

    connect(UserInputService.InputBegan, function(input)
        if not listening then
            return
        end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then
            return
        end
        listening = false
        task.defer(function()
            Capturing = false
        end)
        if input.KeyCode ~= Enum.KeyCode.Escape then
            key = input.KeyCode
            fire(callback, key)
        end
        b.Text = key.Name
    end)

    local obj = {}
    function obj:Get()
        return key
    end
    return obj
end

local Capturing = false
local Minimized = false

do
    local dragging = false
    local dragStart, startPos

    TopBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = Main.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    connect(UserInputService.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            Main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

