local function getPing()
    local ok, v = pcall(function()
        return Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok and typeof(v) == "number" then
        return math.floor(v + 0.5)
    end
    return 0
end

local function updateStatus(fps)
    local ping = getPing()
    local pingColor = ping <= 80 and Theme.Good or (ping <= 150 and Theme.Warn or Theme.Bad)
    local fpsColor = fps >= 50 and Theme.Accent2 or (fps >= 30 and Theme.Warn or Theme.Bad)

    FpsLabel.Text = colorTag(Theme.SubText, "FPS") .. "  " .. colorTag(fpsColor, tostring(fps))
    PingLabel.Text = colorTag(Theme.SubText, "PING") .. "  " .. colorTag(pingColor, tostring(ping) .. " ms")
    GameLabel.Text = colorTag(Theme.SubText, "GAME") .. "  " .. colorTag(Theme.Text, escapeRich(GameName))
end

updateStatus(60)

do
    local frames = 0
    local elapsed = 0
    connect(RunService.RenderStepped, function(dt)
        frames = frames + 1
        elapsed = elapsed + dt
        if elapsed >= 0.5 then
            local fps = math.floor(frames / elapsed + 0.5)
            frames = 0
            elapsed = 0
            if StatusBar.Visible then
                updateStatus(fps)
            end
        end
    end)
end

