local Tabs = {}
local CurrentTab

local function selectTab(tab)
    CurrentTab = tab
    for _, t in ipairs(Tabs) do
        local active = t == tab
        t.Page.Visible = active
        tween(t.Label, 0.15, { TextColor3 = active and Theme.Text or Theme.SubText })
        tween(t.Button, 0.15, { BackgroundTransparency = active and 0 or 1 })
        tween(t.Indicator, 0.15, { BackgroundTransparency = active and 0 or 1 })
    end
end

local Tab = {}
Tab.__index = Tab

local function nextOrder(self)
    self.Order = self.Order + 1
    return self.Order
end

local function row(self, height)
    return new("Frame", {
        Size = UDim2.new(1, 0, 0, height or 34),
        BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0,
        LayoutOrder = nextOrder(self),
        Parent = self.Page,
    }, { corner(3), stroke(Theme.Stroke) })
end

local function hover(frame, button)
    button.MouseEnter:Connect(function()
        tween(frame, 0.12, { BackgroundColor3 = Theme.PanelLight })
    end)
    button.MouseLeave:Connect(function()
        tween(frame, 0.12, { BackgroundColor3 = Theme.Panel })
    end)
end

local function createTab(name)
    local button = new("TextButton", {
        Name = name,
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = Theme.PanelLight,
        BackgroundTransparency = 1,
        AutoButtonColor = false,
        Text = "",
        LayoutOrder = #Tabs + 1,
        Parent = TabList,
    }, { corner(3) })

    local indicator = new("Frame", {
        Size = UDim2.fromOffset(2, 16),
        Position = UDim2.new(0, 0, 0.5, -8),
        BackgroundColor3 = Theme.Accent,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Parent = button,
    })

    local tabLabel = label({
        Text = name,
        TextColor3 = Theme.SubText,
        Size = UDim2.new(1, -16, 1, 0),
        Position = UDim2.fromOffset(14, 0),
        Parent = button,
    })

    local page = new("ScrollingFrame", {
        Name = name,
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        Visible = false,
        Parent = Content,
    }, {
        new("UIListLayout", {
            Padding = UDim.new(0, 6),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }),
        new("UIPadding", {
            PaddingTop = UDim.new(0, 10),
            PaddingLeft = UDim.new(0, 10),
            PaddingRight = UDim.new(0, 12),
            PaddingBottom = UDim.new(0, 10),
        }),
    })

    local tab = setmetatable({
        Name = name,
        Button = button,
        Indicator = indicator,
        Label = tabLabel,
        Page = page,
        Order = 0,
    }, Tab)

    table.insert(Tabs, tab)

    button.MouseEnter:Connect(function()
        if CurrentTab ~= tab then
            tween(button, 0.12, { BackgroundTransparency = 0.6 })
        end
    end)
    button.MouseLeave:Connect(function()
        if CurrentTab ~= tab then
            tween(button, 0.12, { BackgroundTransparency = 1 })
        end
    end)
    button.MouseButton1Click:Connect(function()
        selectTab(tab)
    end)

    if #Tabs == 1 then
        selectTab(tab)
    end

    return tab
end

